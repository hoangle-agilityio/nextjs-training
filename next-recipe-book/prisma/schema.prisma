datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Recipe {
  id          String    @id @default(uuid())
  title       String    @db.VarChar(255)
  description String?
  ingredients String[]
  cuisineType String
  imageUrl    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
}
